# =============================================================================
# Sharma Clinic — environment template (Coolify / Hostinger VPS)
# Copy into Coolify "Environment Variables" (or local .env). Never commit secrets.
# =============================================================================

# PostgreSQL — production connection string only (Prisma 7 + adapter-pg).
# Managed PG often needs TLS, e.g. ?sslmode=require
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth.js (staff login) — required for Coolify behind reverse proxy
# -----------------------------------------------------------------------------
# Generate: npx auth secret   (or openssl rand -base64 32)
AUTH_SECRET=

# Public https origin (no trailing slash). Must match the Coolify domain.
# Example: https://clinic.example.com
# Do NOT use http://localhost in production.
AUTH_URL=

# Required behind Coolify/Traefik/Caddy: app may see HTTP internally while
# the public URL is HTTPS. Trusts X-Forwarded-Host / X-Forwarded-Proto.
AUTH_TRUST_HOST=true

# Public site URL for emails/absolute links (https, not localhost).
# Usually the same origin as AUTH_URL.
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Initial staff admin (seed creates once; never overwrites existing password)
# -----------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# Legacy aliases still accepted by seed (prefer INITIAL_ADMIN_*)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Demo doctor (development only; never auto in production)
SEED_DEMO_DATA=
SEED_DEMO_DOCTOR_EMAIL=
SEED_DEMO_DOCTOR_PASSWORD=

# -----------------------------------------------------------------------------
# Integrations (server-only secrets — never prefix with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_API_KEY=
BREVO_SENDER_NAME=Sharma Clinic
BREVO_SENDER_EMAIL=
BREVO_REPLY_TO_EMAIL=
CLINIC_NAME=Sharma Clinic
CLINIC_PHONE=
CLINIC_ADDRESS=
CLINIC_EMAIL=
CLINIC_TIMEZONE=Asia/Kolkata

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Browser checkout key only (public by design)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# -----------------------------------------------------------------------------
# Logging (stdout/stderr only — no production log files in-app)
# Dev: pretty + debug. Prod: json + info (defaults when unset).
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SLOW_REQUEST_MS=1000
LOG_SLOW_DATABASE_MS=500
LOG_SLOW_EXTERNAL_API_MS=2000

# Optional: only if you ever deploy on Vercel. Coolify/Hostinger do not need this.
# VERCEL_URL=
